;; mova --module-path nx/src nx/test/docs_test.mova   (exit 1 on failure)
(require 'nx.docs 'nx.query 'nx.router)
(defn chk [nm a b] (when (not= a b) (println "FAIL" nm (pr-str a) (pr-str b)) (System/exit 1)))
(def u "file:///a.clj")
(defn ch [v & cs] {:method "textDocument/didChange" :params {:textDocument {:uri u :version v} :contentChanges (vec cs)}})
(defn rng [sl sc el ec t] {:range {:start {:line sl :character sc} :end {:line el :character ec}} :text t})
(let [[d1 ev] (nx.docs/handle {} {:method "textDocument/didOpen" :params {:textDocument {:uri u :version 1 :text "ab\ncd\n"}}})
      [d2 _] (nx.docs/handle d1 (ch 2 (rng 0 1 1 1 "X")))
      [d3 _] (nx.docs/handle d2 (ch 3 (rng 0 0 0 0 "😀") (rng 0 2 0 3 "-")))   ; astral char = 2 UTF-16 units
      [d4 _] (nx.docs/handle d3 (ch 4 {:text "full"}))
      [d5 ev5] (nx.docs/handle d4 (ch 3 {:text "stale"}))
      [d6 ev6] (nx.docs/handle d5 {:method "textDocument/didClose" :params {:textDocument {:uri u}}})]
  (chk "open" ev [{:uri u :version 1 :text "ab\ncd\n"}])
  (chk "inc" (get-in d2 [u :text]) "aXd\n")
  (chk "utf16" (get-in d3 [u :text]) "😀-Xd\n")
  (chk "full" (get-in d4 [u :text]) "full")
  (chk "stale" [(get-in d5 [u :version]) ev5] [4 []])
  (chk "close" [d6 ev6] [{} [{:uri u :closed true}]]))
;; lifecycle
(let [s {:phase :new :cancelled #{} :eng (mova.nx/engine) :versions {} :parked []}
      [s1 o1] (nx.query/handle-req s {:id 1 :method "foo"})
      [s2 o2] (nx.query/handle-req s1 {:id 2 :method "initialize"})
      [s3 o3] (nx.query/handle-req s2 {:id 3 :method "foo"})
      [s4 _] (nx.query/handle-req s3 {:id 4 :method "shutdown"})
      [_ o5] (nx.query/handle-req s4 {:id 5 :method "foo"})
      [_ o6] (nx.query/handle-req s4 {:method "exit"})
      [_ o7] (nx.query/handle-req s2 {:method "exit"})]
  (chk "not-init" (-> o1 first :error :code) -32002)
  (chk "init" (-> o2 first :result :capabilities :hoverProvider) true)
  (chk "unknown" o3 [{:jsonrpc "2.0" :id 3 :result nil}])
  (chk "after-shutdown" (-> o5 first :error :code) -32600)
  (chk "exit0" o6 [{:nx/exit 0}])
  (chk "exit1" o7 [{:nx/exit 1}]))
(println "ok")
