;; MOVA-PATCH: no java.net.URLClassLoader/ClassLoader on Mova -- classpath
;; scan is stubbed to empty per PLAN.md ("Classpath scan ... make it return
;; nil so project-only analysis is used"); jar-file?/filenames-in-jar kept
;; real (no ClassLoader involved).
(ns
  ^{:author "Stuart Sierra"
     :doc "Utilities for dealing with the JVM's classpath"}
  clojure.java.classpath
  (:require [clojure.java.io :as io])
  (:import (java.util.jar JarFile JarEntry)))

(defprotocol URLClasspath
  (urls [loader]
    "Returns a sequence of java.net.URL objects representing locations
  which this classloader will search for classes and resources."))

(defn get-urls
  "MOVA-PATCH: always nil (no URLClassLoader on Mova)."
  [_loader]
  nil)

(defn jar-file?
  "Returns true if file is a normal file with a .jar or .JAR extension."
  [f]
  (let [file (io/file f)]
    (and (.isFile file)
         (or (.endsWith (.getName file) ".jar")
             (.endsWith (.getName file) ".JAR")))))

(defn filenames-in-jar
  "Returns a sequence of Strings naming the non-directory entries in
  the JAR file."
  [^JarFile jar-file]
  (map #(.getName ^JarEntry %)
       (filter #(not (.isDirectory ^JarEntry %))
               (enumeration-seq (.entries jar-file)))))

(defn system-classpath
  "MOVA-PATCH: empty (no JVM system classpath on Mova)."
  []
  ())

(defn loader-classpath
  "MOVA-PATCH: empty (no ClassLoader on Mova)."
  [_loader]
  ())

(defn classpath
  "MOVA-PATCH: empty -- see PLAN.md's classpath-scan stub note."
  ([_classloader] ())
  ([] ()))

(defn classpath-directories
  "MOVA-PATCH: empty."
  []
  ())

(defn classpath-jarfiles
  "MOVA-PATCH: empty."
  []
  ())
